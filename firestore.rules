rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the requesting user authenticated?
    function isAuth() {
      return request.auth != null;
    }

    // Helper: is this the admin (turker@taximact.com)?
    function isAdmin() {
      return isAuth() && request.auth.token.email == 'turker@taximact.com';
    }

    // Helper: is this Arel?
    function isArel() {
      return isAuth() && request.auth.token.email == 'areldenizyuksel@icloud.com';
    }

    // Helper: is this either admin or Arel?
    function isAdminOrArel() {
      return isAdmin() || isArel();
    }

    // User profiles — admin can read/write all; Arel can read/write own
    match /users/{userId} {
      allow read, write: if isAdmin();
      allow read, write: if isArel() && userId == 'arel_deniz';

      // Daily training sessions subcollection
      match /dailySessions/{date} {
        allow read, write: if isAdmin();
        allow read, write: if isArel() && userId == 'arel_deniz';
      }

      // Question attempts — immutable history
      match /attempts/{attemptId} {
        allow read: if isAdmin();
        allow read, create: if isArel() && userId == 'arel_deniz';
        allow update, delete: if isAdmin();
      }

      // Badges subcollection
      match /badges/{badgeId} {
        allow read, write: if isAdminOrArel();
      }

      // Skill stats subcollection
      match /skillStats/{skillId} {
        allow read, write: if isAdmin();
        allow read, write: if isArel() && userId == 'arel_deniz';
      }
    }

    // Custom questions — admin write, both can read
    match /customQuestions/{docId} {
      allow read: if isAdminOrArel();
      allow write: if isAdmin();
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
